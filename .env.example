# Copy to .env.local for development, or set these in the Vercel dashboard.
# The site runs without every one of them; each line says what is lost.

# Canonical origin, used for canonical URLs, og:url, the sitemap and JSON-LD.
# Unset: falls back to the Vercel production URL, then to localhost.
NEXT_PUBLIC_SITE_URL=

# Postgres connection string. Analytics is the only thing that touches it;
# no site content lives in a database.
# Unset: the collector answers 204 and records nothing. The site is unaffected.
POSTGRES_URL=

# Secret the visitor identifier is hashed under, rotated daily against the date.
# Must be at least 16 characters.
# Unset or too short: nothing is recorded at all, rather than being hashed
# under a guessable key, which would look like anonymisation without being it.
ANALYTICS_SALT=

# Password for /admin/analytics. At least 8 characters.
# Unset: the dashboard returns 404, the same as it does when signed out.
ADMIN_PASSWORD=

# Signing secret for the admin session cookie. At least 16 characters.
# The signing key is derived from this and the password together, so changing
# either one invalidates every live session with no table to revoke from.
# Unset: the dashboard returns 404.
ADMIN_SECRET=
